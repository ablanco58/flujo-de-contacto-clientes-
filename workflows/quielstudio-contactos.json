    {
      "parameters": {
        "jsCode": "const d = $json.body.data;\nconst texto = d.message?.conversation || d.message?.extendedTextMessage?.text || '';\nconst lineas = texto.split('\\n').map(l => l.trim()).filter(Boolean);\n\nlet tipo = null;\nconst out = [];\n\nfor (const l of lineas.slice(1)) {\n  const t = l.toLowerCase().replace(/\\s+/g, '_');\n  if (t === 'con_web' || t === 'sin_web') { tipo = t; continue; }\n\n  const [nombre = '', tel = '', email = ''] = l.split(',').map(s => s.trim());\n  const telefono = tel.replace(/\\D/g, '');\n  const emailOk = /^\\S+@\\S+\\.\\S+$/.test(email);\n  const valido = tipo && nombre && (telefono.length >= 8 || emailOk);\n\n  let canal = 'invalido';\n  if (valido) canal = (telefono && emailOk) ? 'ambos' : telefono ? 'whatsapp' : 'email';\n\n  out.push({ json: { nombre, telefono, email: emailOk ? email : '', tipo: tipo || '', canal, lineaOriginal: l } });\n}\n\nreturn out;"
      },
