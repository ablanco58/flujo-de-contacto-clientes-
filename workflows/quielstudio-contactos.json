    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst ok = items.filter(i => i.estado === 'ok');\nconst fail = items.filter(i => i.estado === 'error');\nconst hora = new Date().toLocaleString('es-PA', { timeZone: 'America/Panama' });\n\nlet msg = `📊 *Reporte de envíos* (${hora})\\n`;\nmsg += `Total: ${items.length} | ✅ ${ok.length} | ❌ ${fail.length}\\n\\n`;\n\nif (ok.length) {\n  msg += `✅ *Exitosos*\\n` + ok.map(i => `• ${i.nombre} (${i.canal}, ${i.tipo})`).join('\\n') + '\\n\\n';\n}\n\nif (fail.length) {\n  msg += `❌ *Con problemas*\\n` + fail.map(i => `• ${i.nombre} (${i.canal}): ${i.detalle}`).join('\\n') + '\\n\\n';\n  msg += `⚠️ *Acciones sugeridas*\\n1. Verifica que el número o correo sea válido.\\n2. Revisa credenciales y conexión de Evolution.\\n3. Reenvía solo los fallidos.`;\n} else {\n  msg += `Todo salió sin incidencias.`;\n}\n\nreturn [{ json: { mensaje: msg } }];"
      },
