    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst err = e.execution.error?.message || 'Sin detalle';\n\nlet accion = 'Revisa la ejecución en el enlace y reintenta.';\nif (/401|403|token|credential|unauthorized/i.test(err))\n  accion = 'Renueva o reconecta la credencial del nodo.';\nelse if (/429|rate|limit|quota/i.test(err))\n  accion = 'Límite de envíos alcanzado. Espera y reintenta más despacio.';\nelse if (/ENOTFOUND|ECONN|timeout/i.test(err))\n  accion = 'Problema de red. Verifica que Evolution y n8n estén activos.';\n\nconst msg = `🚨 *Error en el workflow*\\n` +\n  `Workflow: ${e.workflow.name}\\n` +\n  `Nodo: ${e.execution.lastNodeExecuted}\\n` +\n  `Error: ${err}\\n` +\n  `Hora: ${new Date().toLocaleString('es-PA', { timeZone: 'America/Panama' })}\\n` +\n  `Ejecución: ${e.execution.url}\\n\\n` +\n  `⚠️ *Acción recomendada*\\n${accion}`;\n\nreturn [{ json: { mensaje: msg } }];"
      },
