    {
      "parameters": {
        "jsCode": "const ctx = $('Loop Over Items').item.json;\nconst invalido = ctx.canal === 'invalido';\nconst hayError = invalido || !!$json.error;\n\nreturn {\n  json: {\n    nombre: ctx.nombre || '(sin nombre)',\n    tipo: ctx.tipo,\n    canal: invalido ? 'invalido'\n         : $prevNode.name.includes('Gmail') ? 'email' : 'whatsapp',\n    estado: hayError ? 'error' : 'ok',\n    detalle: invalido\n      ? `Línea inválida: \"${ctx.lineaOriginal}\"`\n      : hayError ? ($json.error?.message || $json.error || 'Error desconocido') : 'enviado',\n    fecha: new Date().toISOString()\n  }\n};"
      },
