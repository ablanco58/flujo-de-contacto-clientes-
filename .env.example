# Copia este archivo a .env y reemplaza los tres valores de ejemplo.
# Genera un valor aleatorio diferente para cada variable.
# Usa letras y numeros, por ejemplo cadenas hexadecimales de 64 caracteres.
# POSTGRES_PASSWORD forma parte de una URI: evita caracteres reservados.
N8N_ENCRYPTION_KEY=REEMPLAZA_CON_UNA_CLAVE_ALEATORIA_PROPIA
AUTHENTICATION_API_KEY=REEMPLAZA_CON_OTRA_CLAVE_ALEATORIA_PROPIA
POSTGRES_PASSWORD=REEMPLAZA_CON_UNA_CONTRASENA_ALEATORIA_PROPIA

N8N_PORT=5678
EVOLUTION_PORT=8080
